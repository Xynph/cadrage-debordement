extends RefCounted
## Stable IDs are persisted separately from the career. Only UI navigation is offered.
const TOUR := ["bienvenue", "club", "bureau", "effectif", "composition", "entrainement", "tactique", "premier-match", "resultat", "calendrier", "classements", "finances", "recrutement", "territoire", "packs"]
const PAGES := {
	"bienvenue": ["Accueil", "Bienvenue au club", "Allez, on ouvre le carnet ensemble. Pour commencer, choisissez une nouvelle carrière ou reprenez votre club depuis l'accueil. Suivant et Précédent permettent de feuilleter la visite à votre rythme ; Ouvrir mène à l'écran présenté. Vous pourrez retrouver mon aide quand vous en aurez besoin."],
	"club": ["Création", "Choisir son club", "Un club, c'est le début d'une histoire. Choisissez une division, puis regardez les clubs de la liste et leur objectif. La base anonymisée suffit pour jouer. Quand votre choix est fait, utilisez Prendre les rênes ; si une carrière existe déjà, prenez le temps de lire la confirmation."],
	"bureau": ["Bureau", "Votre point de départ", "Le bureau, c'est notre point de rendez-vous. Commencez par lire les messages et la prochaine rencontre, puis regardez les décisions qui attendent. Les raccourcis vous emmènent directement au bon endroit. La carrière se sauvegarde automatiquement ; le menu permet aussi d'en exporter une copie à conserver."],
	"effectif": ["Effectif", "Connaître ses joueurs", "Avant de choisir une équipe, apprenez à connaître le groupe. Regardez les postes, la condition et les disponibilités, puis sélectionnez un joueur pour ouvrir sa fiche. Les filtres permettent de retrouver les blessés ou les joueurs hors groupe. Prenez d'abord une fiche : le reste se lit plus facilement."],
	"composition": ["Composition", "Préparer la feuille", "Une feuille se prépare poste par poste. Sélectionnez un emplacement, puis regardez les joueurs disponibles pour le couvrir. Vérifiez ensuite les titulaires et le banc ; les qualifications et les indisponibilités limitent certains choix. Une fois la rencontre lancée, vous retrouverez les changements dans l'onglet Banc du match."],
	"entrainement": ["Préparation", "La séance de la semaine", "Avant la séance, jetez un œil à la condition du groupe dans l'effectif. Ici, vous choisissez récupération, charge normale ou intensive. Une seule séance collective est possible par semaine ; la page indique lorsqu'elle a déjà été effectuée. Prenez le temps de choisir la charge qui vous convient."],
	"tactique": ["Préparation", "Vos consignes", "Lisez le détail des consignes, puis choisissez votre intention en attaque et en défense. Les options retenues sont mises en évidence sur les cartes. Vous pourrez les ajuster pendant une pause du match ; aucune formule ne gagne toutes les rencontres. L'essentiel, pour commencer, est de comprendre votre choix."],
	"premier-match": ["Match", "Le premier coup d'envoi", "Nous y voilà. Faites un dernier tour de la feuille et des consignes avant de choisir Coup d'envoi. Pendant la rencontre, les onglets Direct, Banc et Stats donnent trois regards sur le jeu. Utilisez Pause pour décider tranquillement ; je vous laisse suivre le ballon sans bavarder par-dessus."],
	"resultat": ["Match", "Lire le résultat", "Le score donne le résultat, mais prenez aussi un moment pour lire les événements et les Stats. Ils aident à retrouver le fil de la rencontre. Quand vous êtes prêt, choisissez Valider la journée pour poursuivre la compétition. Le calendrier et le bureau garderont ensuite la trace du match."],
	"calendrier": ["Calendrier", "Le fil de la saison", "Regardez d'abord la prochaine échéance, puis les scores des rencontres déjà jouées : le calendrier remet la saison en perspective. Les rendez-vous éliminatoires se précisent au fil de la compétition. Revenez ici après votre premier match pour retrouver son résultat et voir ce qui attend le club."],
	"classements": ["Classements", "Situer le club", "Repérez votre club, puis comparez les points et le nombre de matchs joués. Le tableau rassemble aussi victoires, nuls, défaites et différence de points. Les onglets ouvrent les divisions disponibles. Gardez le calendrier à portée de main : une seule rencontre ne raconte pas toute la saison."],
	"finances": ["Finances", "Les moyens du projet", "Avant de vous engager, regardez la trésorerie et les salaires hebdomadaires. Le journal des flux permet de retrouver les opérations déjà enregistrées. Toutes ces valeurs sont fictives et ne représentent pas les budgets des clubs réels. Commencez par lire une ligne du journal pour comprendre son mouvement."],
	"packs": ["Packs", "Des identités facultatives", "Vous pouvez garder la base anonymisée et jouer tout de suite. Les packs servent à personnaliser les identités ; prenez le temps de lire leur description et les avertissements avant d'importer ou de sélectionner un pack. Si celui d'une carrière manque, cette page vous permet de vous en occuper."],
	"recrutement": ["Recrutement", "Construire l'effectif", "Un renfort se regarde d'abord en fonction des postes que vous souhaitez couvrir. Parcourez les joueurs disponibles, puis ouvrez une proposition pour lire salaire, durée et coût. Le joueur peut refuser ou faire une contre-offre : lisez sa réponse avant de poursuivre. Une proposition n'est pas encore une signature."],
	"territoire": ["Club", "Un club, un territoire", "Prenez aussi le temps de regarder où votre histoire se joue. Cette page rassemble l'identité du club et des photographies d'archive de son territoire et de son stade. Le bouton Crédits et licences permet d'en retrouver les sources. Puis revenez au bureau pour préparer la suite."]
}
static func for_route(route: String, model: Dictionary) -> String:
	if route == "Match":
		var live: Dictionary = model.get("live", {}) if model.get("live") is Dictionary else {}
		return "resultat" if live.get("finished", false) else "premier-match"
	for id in PAGES:
		if PAGES[id][0] == route: return id
	return "bienvenue"
